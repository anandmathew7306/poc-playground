{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.io/schemas/profile.schema.json",
  "title": "ClientProfile",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.io/v1" },
    "kind": { "const": "ClientProfile" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "display_name",
        "platform",
        "platform_skill",
        "cloud",
        "cloud_skill",
        "active_skills"
      ],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "platform": {
          "type": "string",
          "enum": ["ocp", "rosa", "rosa-hcp", "eks"]
        },
        "platform_skill": { "type": "string", "minLength": 1 },
        "cloud": {
          "type": "string",
          "enum": ["aws", "azure", "on-prem"]
        },
        "cloud_skill": { "type": "string", "minLength": 1 },
        "deploy_tool": {
          "type": "string",
          "enum": ["helm", "kustomize", "both"]
        },
        "deploy_skill": { "type": "string" },
        "acm": {
          "type": "object",
          "properties": {
            "managed": { "type": "boolean" },
            "policy_set": { "type": "string" },
            "placement": { "type": "string" }
          }
        },
        "sre": {
          "type": "object",
          "properties": {
            "slo_file": { "type": "string" },
            "alerting": { "type": "string" },
            "observability_skill": { "type": "string" },
            "dashboard_url": { "type": "string" }
          }
        },
        "docs": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string",
              "enum": ["confluence", "notion", "github-wiki", "gdocs"]
            },
            "space_url": { "type": "string" },
            "runbook_path": { "type": "string" }
          }
        },
        "compliance": {
          "type": "object",
          "properties": {
            "frameworks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "data_classification": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "restricted"]
            },
            "audit_logging": { "type": "boolean" }
          }
        },
        "terminology": {
          "type": "object",
          "properties": {
            "environment_names": {
              "type": "object",
              "properties": {
                "prod": { "type": "string" },
                "nonprod": { "type": "string" }
              }
            },
            "cluster_naming": { "type": "string" },
            "ticket_prefix": { "type": "string" }
          }
        },
        "active_skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  }
}
