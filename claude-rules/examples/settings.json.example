{
  "permissions": {
    "deny": [
      "Bash(oc apply:*)", "Bash(oc delete:*)", "Bash(oc patch:*)", "Bash(oc edit:*)",
      "Bash(oc adm:*)", "Bash(oc exec:*)", "Bash(oc rsh:*)", "Bash(oc whoami -t:*)",
      "Bash(kubectl apply:*)", "Bash(kubectl delete:*)", "Bash(kubectl patch:*)",
      "Bash(kubectl edit:*)", "Bash(kubectl exec:*)",
      "Bash(helm install:*)", "Bash(helm upgrade:*)", "Bash(helm uninstall:*)",
      "Bash(argocd app sync:*)", "Bash(terraform apply:*)", "Bash(terraform destroy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/block-cluster-writes.py" },
          { "type": "command", "command": "~/.claude/hooks/confirm-deletes.py" },
          { "type": "command", "command": "~/.claude/hooks/confirm-cloud.py" },
          { "type": "command", "command": "~/.claude/hooks/confirm-secrets.py" },
          { "type": "command", "command": "~/.claude/hooks/check-git-identity.py" },
          { "type": "command", "command": "~/.claude/hooks/protect-repos.py" }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/confirm-secrets.py" }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/protect-repos.py" }
        ]
      }
    ]
  }
}
