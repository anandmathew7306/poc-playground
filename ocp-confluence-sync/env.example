# Copy to .env, fill in real values. .env is gitignored -- never commit it.
CONFLUENCE_EMAIL=<your-atlassian-email>
CONFLUENCE_TOKEN=<your-api-token>
CONFLUENCE_BASE=https://<your-site>.atlassian.net
PAGE_ID=<confluence-page-id>
CM_NAMESPACE=<namespace-of-source-configmap>
CM_NAME=<configmap-name>
CM_KEY=<configmap-data-key>
